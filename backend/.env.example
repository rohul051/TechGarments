# TechGarments Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Firebase Configuration
# Project ID from Firebase Console: https://console.firebase.google.com/project/techgarments-cdd93/overview
FIREBASE_PROJECT_ID=techgarments-cdd93
FIREBASE_STORAGE_BUCKET=techgarments-cdd93.firebasestorage.app

# Path to Firebase Admin SDK service account key JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Alternatively, set service account credentials via environment variables:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
