rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // prevent accidental account deletion
    }

    // Buyer profiles collection
    match /buyers/{buyerId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == buyerId;
    }

    // Factory profiles collection
    match /factories/{factoryId} {
      allow read: if true; // Public directory for buyers to discover factories
      allow write: if isAuthenticated() && request.auth.uid == factoryId;
    }

    // Orders and RFQs collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.factoryId == request.auth.uid ||
        resource.data.factoryId == null // Public RFQs
      );
      allow create: if isAuthenticated() &&
        request.resource.data.buyerId == request.auth.uid && (
          (
            request.resource.data.factoryId == null &&
            request.resource.data.status == "PENDING_QUOTE"
          ) ||
          (
            request.resource.data.factoryId is string &&
            request.resource.data.status == "PENDING_FACTORY_CONFIRMATION" &&
            request.resource.data.quoteId is string &&
            exists(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)) &&
            get(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.buyerId == request.auth.uid &&
            get(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.factoryId == request.resource.data.factoryId &&
            get(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.requestId == request.resource.data.requestId &&
            get(/databases/$(database)/documents/quotes/$(request.resource.data.quoteId)).data.status == "PENDING"
          )
        );
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]) &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.factoryId == resource.data.factoryId &&
        (
          (
            resource.data.buyerId == request.auth.uid &&
            request.resource.data.status == resource.data.status
          ) ||
          (
            resource.data.factoryId == request.auth.uid &&
            resource.data.status == "PENDING_FACTORY_CONFIRMATION" &&
            request.resource.data.status in ["CONFIRMED", "CANCELLED"]
          )
      );
    }

    // Factory quotations are visible only to the factory and the buyer on the source RFQ.
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.factoryId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.factoryId == request.auth.uid &&
        request.resource.data.requestId is string &&
        request.resource.data.pricePerUnit is number &&
        request.resource.data.pricePerUnit > 0 &&
        exists(/databases/$(database)/documents/orders/$(request.resource.data.requestId)) &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.requestId)).data.buyerId == request.resource.data.buyerId &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.requestId)).data.factoryId == null &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.requestId)).data.status == "PENDING_QUOTE";
      allow update, delete: if false;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isAuthenticated() && (
        request.resource.data.factoryId == request.auth.uid ||
        resource.data.factoryId == request.auth.uid
      );
    }

    // Messaging & Conversations
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Push Notification Device Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }
  }
}
